{
  "name": "@vpmedia/bitcharify-phaser2",
  "version": "1.14.0",
  "description": "@vpmedia/bitcharify-phaser2 is the integration add-on for the @vpmedia/bitcharify bitmap font generator with the Phaser v2 game engine",
  "author": "Andras Csizmadia <andras@vpmedia.hu> (www.vpmedia.hu)",
  "license": "MIT",
  "homepage": "https://github.com/vpmedia/bitcharify-phaser2#readme",
  "bugs": {
    "url": "https://github.com/vpmedia/bitcharify-phaser2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vpmedia/bitcharify-phaser2.git"
  },
  "keywords": [
    "bitcharify",
    "phaser",
    "phaser2"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@vpmedia/phaser": "^1.109.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.11.6",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rolldown": "^1.2.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "rm -rf dist && rolldown -c && tsc -p tsconfig.json --emitDeclarationOnly",
    "check": "pnpm lint && pnpm test && pnpm typecheck && pnpm build",
    "test": "vitest --coverage --pass-with-no-tests",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json,css}\""
  }
}
